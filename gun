local function valid(pl)
 if pl==LP or not pl.Character then return false end
 local h=pl.Character:FindFirstChildOfClass("Humanoid")
 local pt=pl.Character:FindFirstChild(G.Part) or pl.Character:FindFirstChild("Head")
 if not h or h.Health<=0 or not pt then return false end
 if G.Team and pl.Team==LP.Team then return false end
 return true
end

local function visible(part,char)
 if not G.Vis then return true end
 local par=RaycastParams.new()
 par.FilterType=Enum.RaycastFilterType.Exclude
 par.FilterDescendantsInstances={LP.Character,CAM}
 local r=workspace:Raycast(CAM.CFrame.Position,part.Position-CAM.CFrame.Position,par)
 return not r or r.Instance:IsDescendantOf(char)
end

local function target()
 local best=nil
 local bd=G.FOV
 local center=CAM.ViewportSize/2

 for _,pl in ipairs(P:GetPlayers()) do
  if valid(pl) then
   local pt=pl.Character:FindFirstChild(G.Part) or pl.Character:FindFirstChild("Head")
   local pos,on=CAM:WorldToViewportPoint(pt.Position)
   if on then
    local d=(Vector2.new(pos.X,pos.Y)-center).Magnitude
    local wd=(CAM.CFrame.Position-pt.Position).Magnitude
    if d<bd and wd<=G.Max and visible(pt,pl.Character) then
     bd=d
     best=pl
    end
   end
  end
 end

 return best
end

