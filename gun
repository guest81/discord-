RS.RenderStepped:Connect(function()
 if G.Aim or G.Assist then
  ring.Visible=true
  ring.Size=UDim2.fromOffset(G.FOV*2,G.FOV*2)
  ring.Position=UDim2.new(.5,-G.FOV,.5,-G.FOV)

  if not G.Sticky or not lock or not valid(lock) then
   lock=target()
  end

  if lock and valid(lock) then
   local pt=lock.Character:FindFirstChild(G.Part) or lock.Character:FindFirstChild("Head")
   if pt then
    local pos=pt.Position+pt.AssemblyLinearVelocity*G.Pred
    local goal=CFrame.lookAt(CAM.CFrame.Position,pos)
    local power=G.Aim and G.Smooth or math.clamp(G.Smooth*.3,.01,.35)
    CAM.CFrame=CAM.CFrame:Lerp(goal,power)
   end
  end
 else
  ring.Visible=false
  lock=nil
 end
end)

local vel
local att

local function fly()
 local c=LP.Character
 if not c then return end
 local hr=c:FindFirstChild("HumanoidRootPart")
 local h=c:FindFirstChildOfClass("Humanoid")
 if not hr then return end

 if G.Fly then
  if not att then
   att=Instance.new("Attachment")
   att.Parent=hr

   vel=Instance.new("LinearVelocity")
   vel.Attachment0=att
   vel.MaxForce=math.huge
   vel.RelativeTo=Enum.ActuatorRelativeTo.World
   vel.Parent=hr
  end

  local d=h and h.MoveDirection or Vector3.zero
  local flat=Vector3.new(CAM.CFrame.LookVector.X,0,CAM.CFrame.LookVector.Z)

  if flat.Magnitude>0 then
   flat=flat.Unit
  end

  local right=Vector3.new(CAM.CFrame.RightVector.X,0,CAM.CFrame.RightVector.Z)

  if right.Magnitude>0 then
   right=right.Unit
  end

  local x=d:Dot(right)
  local z=d:Dot(flat)

  local mv=right*x+flat*z
  vel.VectorVelocity=mv*65
  hr.AssemblyAngularVelocity=Vector3.zero
 else
  if vel then vel:Destroy() vel=nil end
  if att then att:Destroy() att=nil end
 end
end

