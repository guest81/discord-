local function scriptScore(script, query)
    local title = tostring(script.title or ""):lower()
    local gameName = tostring(
        script.game and script.game.name or ""
    ):lower()

    local q = tostring(query):lower()
    local score = 0

    if title == q then
        score += 100
    end

    if title:find(q, 1, true) then
        score += 50
    end

    local gameNameCurrent = tostring(game.Name):lower()

    if gameName == gameNameCurrent then
        score += 75
    end

    if script.game and tostring(script.game.gameId) == tostring(game.PlaceId) then
        score += 100
    end

    if script.verified then
        score += 18
    end

    if script.isUniversal then
        score += 8
    end

    if not script.isPatched then
        score += 15
    else
        score -= 100
    end

    if not script.key then
        score += 5
    end

    score += math.min(
        math.log10(math.max(tonumber(script.views) or 0, 1)) * 3,
        25
    )

    local tokens = splitWords(q)
    local searchable = (
        title .. " "
        .. gameName .. " "
        .. tostring(script.matched or "")
    )

    for _, token in ipairs(tokens) do
        if searchable:find(token, 1, true) then
            score += 8
        end
    end

    return score
end

local function addResults(list)
    local seen = {}
    local clean = {}

    for _, script in ipairs(list) do
        local id = tostring(
            script._id
            or script.slug
            or script.title
            or math.random()
        )

        if not seen[id] then
            seen[id] = true

            if Config.Search.NoPatched and script.isPatched then
                continue
            end

            if Config.Search.NoKey and script.key then
                continue
            end

            if Config.Search.Verified and not script.verified then
                continue
            end

            clean[#clean + 1] = script
        end
    end

    return clean
end

local function searchScripts(query)
    SearchStatus.Text = "Searching ScriptBlox..."
    Results.Visible = true
    Details.Visible = false

    for _, child in ipairs(Results:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local all = {}

    local function requestSearch(q, usePlace)
        local params = {
            "q=" .. encode(q),
            "max=" .. tostring(Config.Search.Max),
            "sortBy=accuracy",
            "order=desc",
            "strict=" .. tostring(Config.Search.Smart)
        }

        if usePlace then
            params[#params + 1] =
                "placeId=" .. tostring(game.PlaceId)
        end

        if Config.Search.Verified then
            params[#params + 1] = "verified=1"
        end

        if Config.Search.NoPatched then
            params[#params + 1] = "patched=0"
        end

        if Config.Search.NoKey then
            params[#params + 1] = "key=0"
        end

        local url =
            "https://scriptblox.com/api/script/search?"
            .. table.concat(params, "&")

        local body = httpGet(url)

        if not body then
            return
        end

        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not ok or not decoded then
            return
        end

        if decoded.result and decoded.result.scripts then
            for _, script in ipairs(decoded.result.scripts) do
                all[#all + 1] = script
            end
        end
    end

    requestSearch(
        query,
        Config.Search.CurrentGame
    )

    if Config.Search.Smart and #all < 5 then
        requestSearch(query, false)
    end

    if Config.Search.Smart
        and Config.Search.CurrentGame
        and #all < 5 then

        requestSearch(game.Name, true)
    end

    all = addResults(all)

    table.sort(all, function(a, b)
        return scriptScore(a, query) > scriptScore(b, query)
    end)

    SearchStatus.Text =
        tostring(#all)
        .. " results • ranked intelligently"

    for index, script in ipairs(all) do
        if index > Config.Search.Max then
            break
        end

        local card = Instance.new("Frame")
