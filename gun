local CurrentTarget = nil

local function getTargetPart(character)
    return character:FindFirstChild(Config.Aim.TargetPart)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
end

local function visibleTarget(part, character)
    if not Config.Aim.VisibleCheck then
        return true
    end

    local origin = Camera.CFrame.Position
    local direction = part.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {
        LocalPlayer.Character,
        character
    }

    local result = Workspace:Raycast(origin, direction, params)

    return result == nil
end

local function targetScore(player)
    if not alive(player) then
        return math.huge
    end

    if not isEnemy(player) then
        return math.huge
    end

    local root = getRoot(player)

    if not root then
        return math.huge
    end

    local localRoot = getRoot(LocalPlayer)

    if localRoot then
        local distance = (root.Position - localRoot.Position).Magnitude

        if distance > Config.Aim.MaxDistance then
            return math.huge
        end
    end

    local part = getTargetPart(player.Character)

    if not part then
        return math.huge
    end

    local viewport, onScreen = Camera:WorldToViewportPoint(part.Position)

    if not onScreen or viewport.Z <= 0 then
        return math.huge
    end

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    local screenDistance = (
        Vector2.new(viewport.X, viewport.Y) - center
    ).Magnitude

    if screenDistance > Config.Aim.FOV then
        return math.huge
    end

    if not visibleTarget(part, player.Character) then
        return math.huge
    end

    return screenDistance
end

local function acquireTarget()
    local best = nil
    local bestScore = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local score = targetScore(player)

            if score < bestScore then
                bestScore = score
                best = player
            end
        end
    end

    return best
end

local function validCurrentTarget()
    if not CurrentTarget then
        return false
    end

    return targetScore(CurrentTarget) ~= math.huge
end

