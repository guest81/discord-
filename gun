  Parent=f,
  Position=UDim2.fromOffset(0,31),
  Size=UDim2.new(1,0,0,5),
  BackgroundColor3=Color3.fromRGB(47,48,54),
  BorderSizePixel=0
 })
 N("UICorner",{Parent=bar,CornerRadius=UDim.new(1,0)})

 local fill=N("Frame",{
  Parent=bar,
  Size=UDim2.fromScale(math.clamp((G[k]-a)/(z-a),0,1),1),
  BackgroundColor3=Color3.fromRGB(175,177,185),
  BorderSizePixel=0
 })
 N("UICorner",{Parent=fill,CornerRadius=UDim.new(1,0)})

 local drag=false

 local function set(x)
  local q=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
  G[k]=math.floor((a+(z-a)*q)*100)/100
  fill.Size=UDim2.fromScale(q,1)
  v.Text=tostring(G[k])
 end

 bar.InputBegan:Connect(function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
   drag=true
   set(i.Position.X)
  end
 end)

 UIS.InputChanged:Connect(function(i)
  if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
   set(i.Position.X)
  end
 end)

 UIS.InputEnded:Connect(function(i)
  if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
   drag=false
  end
 end)

 return f
end

