local function makeDrawing(kind)
    if typeof(Drawing) ~= "table" then
        return nil
    end

    local ok, object = pcall(function()
        return Drawing.new(kind)
    end)

    return ok and object or nil
end

local function removeESP(player)
    local data = ESPData[player]

    if not data then
        return
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    if data.Billboard then
        data.Billboard:Destroy()
    end

    for _, line in ipairs(data.Skeleton or {}) do
        pcall(function()
            line:Remove()
        end)
    end

    for _, line in ipairs(data.Tracer or {}) do
        pcall(function()
            line:Remove()
        end)
    end

    if data.HeadCircle then
        pcall(function()
            data.HeadCircle:Remove()
        end)
    end

    ESPData[player] = nil
end

local function createESP(player)
    if player == LocalPlayer then
        return
    end

    removeESP(player)

    local data = {
        Skeleton = {},
        Tracer = {}
    }

    local highlight = Instance.new("Highlight")
    highlight.Name = "Box"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.78
    highlight.OutlineTransparency = 0
    highlight.FillColor = Colors.Box
    highlight.OutlineColor = Colors.Box
    highlight.Enabled = false
    highlight.Parent = ESPFolder

    data.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Info"
    billboard.Size = UDim2.fromOffset(170, 65)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = false
    billboard.MaxDistance = Config.ESP.Distance
    billboard.Parent = ESPFolder

    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.TextColor3 = Colors.Name
    text.TextStrokeTransparency = 0.55
    text.Font = Enum.Font.GothamBold
    text.TextSize = 11
    text.TextYAlignment = Enum.TextYAlignment.Top
    text.Parent = billboard

    data.Billboard = billboard
    data.Text = text

    for _ = 1, 20 do
        local line = makeDrawing("Line")

        if line then
            line.Visible = false
            line.Thickness = 1.3
            line.Transparency = 0.9
            line.Color = Colors.Skeleton
            data.Skeleton[#data.Skeleton + 1] = line
        end
    end

    local tracer = makeDrawing("Line")

    if tracer then
        tracer.Visible = false
        tracer.Thickness = 1.3
        tracer.Transparency = 0.85
        tracer.Color = Colors.Tracer
        data.Tracer[1] = tracer
    end

    local headCircle = makeDrawing("Circle")

    if headCircle then
        headCircle.Visible = false
        headCircle.Filled = false
        headCircle.Thickness = 1.4
        headCircle.NumSides = 24
        headCircle.Color = Colors.Head
        headCircle.Transparency = 0.9
        data.HeadCircle = headCircle
    end

    ESPData[player] = data
end

local function updateESP(player, data)
    if not Config.ESP.Enabled then
        data.Highlight.Enabled = false
        data.Billboard.Enabled = false

        for _, line in ipairs(data.Skeleton) do
            line.Visible = false
        end

        for _, line in ipairs(data.Tracer) do
            line.Visible = false
        end

        if data.HeadCircle then
            data.HeadCircle.Visible = false
        end

        return
    end

    if not alive(player) or not isEnemy(player) then
        data.Highlight.Enabled = false
        data.Billboard.Enabled = false

        for _, line in ipairs(data.Skeleton) do
            line.Visible = false
        end

        for _, line in ipairs(data.Tracer) do
            line.Visible = false
        end

        if data.HeadCircle then
            data.HeadCircle.Visible = false
        end

        return
    end

    local character = player.Character
    local root = getRoot(player)
    local head = character:FindFirstChild("Head")

    if not root then
        return
    end

    local localRoot = getRoot(LocalPlayer)

    if localRoot then
        local distance = (root.Position - localRoot.Position).Magnitude

        if distance > Config.ESP.Distance then
            data.Highlight.Enabled = false
            data.Billboard.Enabled = false
            return
        end
    end

    local isTarget = CurrentTarget == player

    data.Highlight.Adornee = character
    data.Highlight.Enabled = Config.ESP.Box

    data.Highlight.FillColor = Colors.Box
    data.Highlight.OutlineColor = isTarget
        and Colors.Target
        or Colors.Box

    local hum = getHumanoid(player)
    local hp = hum and hum.Health or 0
    local maxHp = hum and hum.MaxHealth or 100

    local info = ""

    if Config.ESP.Name then
        info = info .. player.DisplayName
    end

    if Config.ESP.Health then
        info = info .. string.format(
            "\n<font color='#46ff91'>HP %d/%d</font>",
            hp,
            maxHp
        )
    end

    if Config.ESP.DistanceText and localRoot then
        local distance = math.floor(
            (root.Position - localRoot.Position).Magnitude
        )

        info = info .. string.format(
            "\n<font color='#ffd746'>%dm</font>",
            distance
        )
    end

    data.Text.RichText = true
    data.Text.Text = info

    data.Billboard.Adornee = head or root
    data.Billboard.Enabled =
        Config.ESP.Name
        or Config.ESP.Health
        or Config.ESP.DistanceText

    --------------------------------------------------
    -- SKELETON
    --------------------------------------------------

    for _, line in ipairs(data.Skeleton) do
        line.Visible = false
    end

    if Config.ESP.Skeleton then
        local pairs = character:FindFirstChild("UpperTorso")
            and SkeletonR15
            or SkeletonR6

        local index = 1

        for _, pair in ipairs(pairs) do
            local a = character:FindFirstChild(pair[1])
            local b = character:FindFirstChild(pair[2])

            local line = data.Skeleton[index]

            if a and b and line then
                local pa, va = Camera:WorldToViewportPoint(a.Position)
                local pb, vb = Camera:WorldToViewportPoint(b.Position)

                if va and vb and pa.Z > 0 and pb.Z > 0 then
                    line.From = Vector2.new(pa.X, pa.Y)
                    line.To = Vector2.new(pb.X, pb.Y)
                    line.Color = isTarget
                        and Colors.Target
                        or Colors.Skeleton
                    line.Visible = true
                end
            end

            index += 1
        end
    end

    --------------------------------------------------
    -- TRACER
    --------------------------------------------------

    if Config.ESP.Tracer and data.Tracer[1] then
        local point, visible = Camera:WorldToViewportPoint(root.Position)

        if visible and point.Z > 0 then
            data.Tracer[1].From = Vector2.new(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y
            )

            data.Tracer[1].To = Vector2.new(
                point.X,
                point.Y
            )

            data.Tracer[1].Color = isTarget
                and Colors.Target
                or Colors.Tracer

            data.Tracer[1].Visible = true
        else
            data.Tracer[1].Visible = false
        end
    end

    --------------------------------------------------
    -- HEAD
    --------------------------------------------------

    if Config.ESP.Head and data.HeadCircle and head then
        local point, visible = Camera:WorldToViewportPoint(head.Position)

        if visible and point.Z > 0 then
            local radius = math.clamp(
                230 / math.max(point.Z, 1),
                3,
                16
            )

            data.HeadCircle.Position = Vector2.new(point.X, point.Y)
            data.HeadCircle.Radius = radius
            data.HeadCircle.Color = isTarget
                and Colors.Target
                or Colors.Head
            data.HeadCircle.Visible = true
        else
            data.HeadCircle.Visible = false
        end
    end
end

