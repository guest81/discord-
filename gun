--==============================================================
-- AIM SYSTEM
--==============================================================

local LockedTarget

local function getClosestTarget()
    local closestPlayer = nil
    local closestDistance = math.huge

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    local localRoot = getRoot(LocalPlayer.Character)

    if not localRoot then
        return nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
            and isAlive(player)
            and isEnemy(player) then

            local character = player.Character
            local part = getTargetPart(character)

            if part then
                local distance3D =
                    (part.Position - localRoot.Position).Magnitude

                if distance3D <= CONFIG.Aim.MaxDistance then
                    local screen, visible =
                        Camera:WorldToViewportPoint(part.Position)

                    if screen.Z > 0 then
                        local screenDistance =
                            (Vector2.new(screen.X, screen.Y) - center).Magnitude

                        if screenDistance <= CONFIG.Aim.FOV then
                            local allowed = true

                            if CONFIG.Aim.VisibleCheck then
                                allowed = visibleFromCamera(part)
                            end

                            if allowed and screenDistance < closestDistance then
                                closestDistance = screenDistance
                                closestPlayer = player
                            end
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

local function getPredictedPosition(part)
    local velocity = Vector3.zero

    pcall(function()
        velocity = part.AssemblyLinearVelocity
    end)

    local pingSeconds = math.clamp(getPing() / 1000, 0, 0.5)

    local predictionTime =
        CONFIG.Aim.Prediction
        + pingSeconds * 0.35

    return part.Position + velocity * predictionTime
end

local function aimAt(player, dt, assist)
    if not player or not isAlive(player) then
        return false
    end

    local part = getTargetPart(player.Character)

    if not part then
        return false
    end

    local targetPosition = getPredictedPosition(part)
    local screen = Camera:WorldToViewportPoint(targetPosition)

    if screen.Z <= 0 then
        return false
    end

    local cameraPosition = Camera.CFrame.Position
    local desired = CFrame.lookAt(
        cameraPosition,
        targetPosition
    )

    local smooth = CONFIG.Aim.Smooth

    if assist then
        smooth = math.clamp(smooth * 2.5, 0.08, 0.8)
    else
        smooth = math.clamp(smooth * 0.45, 0.025, 0.45)
    end

    local alpha =
        1 - math.exp(
            -dt / math.max(smooth, 0.01)
        )

    Camera.CFrame = Camera.CFrame:Lerp(
        desired,
        math.clamp(alpha, 0, 1)
    )

    return true
end

