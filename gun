local function createTab(name)
    local b = button(
        TabBar,
        name,
        UDim2.fromOffset(58, 28)
    )

    b.TextSize = 9

    tabs[name] = b

    b.MouseButton1Click:Connect(function()
        if currentPage then
            currentPage.Visible = false
        end

        local target = ({
            Combat = CombatPage,
            Visual = VisualPage,
            Move = MovePage,
            World = WorldPage,
            Util = UtilityPage,
            Scripts = ScriptsPage,
        })[name]

        if target then
            target.Visible = true
            currentPage = target
        end

        for _, tab in pairs(tabs) do
            tab.BackgroundTransparency = 0.35
            tab.TextColor3 = CONFIG.UI.Muted
        end

        b.BackgroundTransparency = 0.05
        b.TextColor3 = CONFIG.UI.Text
        playSound("Click")
    end)

    return b
end

