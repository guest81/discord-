local function httpGet(url)
    local requestFunctions = {
        function()
            if syn and syn.request then
                local r = syn.request({
                    Url = url,
                    Method = "GET",
                })

                if r and r.Body then
                    return r.Body
                end
            end
        end,

        function()
            if request then
                local r = request({
                    Url = url,
                    Method = "GET",
                })

                if r and r.Body then
                    return r.Body
                end
            end
        end,

        function()
            if http_request then
                local r = http_request({
                    Url = url,
                    Method = "GET",
                })

                if r and r.Body then
                    return r.Body
                end
            end
        end,

        function()
            if fluxus and fluxus.request then
                local r = fluxus.request({
                    Url = url,
                    Method = "GET",
                })

                if r and r.Body then
                    return r.Body
                end
            end
        end,

        function()
            return game:HttpGet(url)
        end,
    }

    for _, fn in ipairs(requestFunctions) do
        local ok, body = pcall(fn)

        if ok and type(body) == "string" and #body > 0 then
            return body
        end
    end

    return nil
end

local function jsonDecode(text)
    local ok, result = pcall(function()
        return HttpService:JSONDecode(text)
    end)

    if ok then
        return result
    end

    return nil
end

local function encode(str)
