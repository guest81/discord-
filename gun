local function toggle(parent, title, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 35)
    row.BackgroundColor3 = CONFIG.UI.Panel
    row.BackgroundTransparency = 0.28
    row.BorderSizePixel = 0
    row.Parent = parent
    round(row, 9)

    local txt = label(row, title, UDim2.new(1, -80, 1, 0), UDim2.fromOffset(10, 0), 11)

    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(54, 23)
    b.Position = UDim2.new(1, -63, 0.5, -11)
    b.BackgroundColor3 = Color3.fromRGB(70, 72, 78)
    b.BackgroundTransparency = 0.15
    b.BorderSizePixel = 0
    b.Font = Enum.Font.GothamBold
    b.TextSize = 9
    b.AutoButtonColor = false
    b.Parent = row
    round(b, 7)

    local state = default == true

    local function render()
        b.Text = state and "ON" or "OFF"
        b.TextColor3 = state
            and Color3.fromRGB(225, 228, 233)
            or Color3.fromRGB(145, 148, 155)

        b.BackgroundColor3 = state
            and Color3.fromRGB(92, 95, 102)
            or Color3.fromRGB(55, 57, 63)
    end

    render()

    local function setState(value)
        state = value == true
        render()
        playSound(state and "Modern" or "Soft")
        safeCall(callback, state)
    end

    b.MouseButton1Click:Connect(function()
        setState(not state)
    end)

    row.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            setState(not state)
        end
    end)

    return {
        Set = setState,
        Get = function()
            return state
        end,
        Button = b,
    }
end

local function slider(parent, title, min, max, default, callback, decimals)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -2, 0, 47)
    row.BackgroundColor3 = CONFIG.UI.Panel
    row.BackgroundTransparency = 0.28
    row.BorderSizePixel = 0
    row.Parent = parent
    round(row, 9)

    local titleLabel = label(
        row,
        title,
        UDim2.new(0.65, 0, 0, 20),
        UDim2.fromOffset(10, 3),
        10
    )

    local valueLabel = label(
        row,
        "",
        UDim2.fromOffset(80, 20),
        UDim2.new(1, -90, 0, 3),
        10
    )
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 5)
    bar.Position = UDim2.fromOffset(10, 31)
    bar.BackgroundColor3 = Color3.fromRGB(60, 62, 68)
    bar.BorderSizePixel = 0
    bar.Parent = row
    round(bar, 5)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(155, 159, 166)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    round(fill, 5)

    local value = default

    local function render()
        local alpha = math.clamp((value - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)

        if decimals and decimals > 0 then
            valueLabel.Text = string.format("%." .. decimals .. "f", value)
        else
            valueLabel.Text = tostring(math.floor(value + 0.5))
        end
    end

    local function setValueFromX(x)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        value = min + (max - min) * alpha

        if decimals and decimals > 0 then
            local power = 10 ^ decimals
            value = math.floor(value * power + 0.5) / power
        else
            value = math.floor(value + 0.5)
        end

        render()
        safeCall(callback, value)
    end

    render()

    local holding = false

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            holding = true
            setValueFromX(input.Position.X)
        end
    end)

    bar.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            holding = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if holding and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setValueFromX(input.Position.X)
        end
    end)

    return {
        Set = function(v)
            value = math.clamp(v, min, max)
            render()
            safeCall(callback, value)
        end,
        Get = function()
            return value
        end,
    }
end

