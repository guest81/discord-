local function http(url)
 local fs={
  syn and syn.request,
  request,
  http_request,
  fluxus and fluxus.request
 }

 for _,f in ipairs(fs) do
  if f then
   local ok,r=pcall(f,{
    Url=url,
    Method="GET",
    Headers={["User-Agent"]="Cyther"}
   })
   if ok and r then
    if r.Body then return r.Body end
    if r.body then return r.body end
   end
  end
 end

 local ok,r=pcall(function()
  return game:HttpGet(url)
 end)

 if ok then return r end
end

