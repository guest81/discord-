local function setDrawingVisible(obj, value)
    if obj then
        pcall(function()
            obj.Visible = value
        end)
    end
end

local function updateESP(player, data)
    if not CONFIG.ESP.Enabled then
        data.Billboard.Enabled = false
        data.Highlight.Enabled = false

        for _, line in pairs(data.Lines) do
            setDrawingVisible(line, false)
        end

        setDrawingVisible(data.Tracer, false)
        setDrawingVisible(data.Head, false)
        return
    end

    if CONFIG.ESP.TeamCheck
        and LocalPlayer.Team
        and player.Team
        and LocalPlayer.Team == player.Team then

        data.Billboard.Enabled = false
        data.Highlight.Enabled = false

        for _, line in pairs(data.Lines) do
            setDrawingVisible(line, false)
        end

        setDrawingVisible(data.Tracer, false)
        setDrawingVisible(data.Head, false)
        return
    end

    local character = player.Character
    local root = getRoot(character)
    local hum = getHumanoid(character)

    if not character or not root or not hum or hum.Health <= 0 then
        data.Billboard.Enabled = false
        data.Highlight.Enabled = false

        for _, line in pairs(data.Lines) do
            setDrawingVisible(line, false)
        end

        setDrawingVisible(data.Tracer, false)
        setDrawingVisible(data.Head, false)
        return
    end

    local localRoot = getRoot(LocalPlayer.Character)

    if not localRoot then return end

    local distance = (root.Position - localRoot.Position).Magnitude

    if distance > CONFIG.ESP.MaxDistance then
        data.Billboard.Enabled = false
        data.Highlight.Enabled = false

        for _, line in pairs(data.Lines) do
            setDrawingVisible(line, false)
        end

        setDrawingVisible(data.Tracer, false)
        setDrawingVisible(data.Head, false)
        return
    end

    local rootScreen, rootVisible = Camera:WorldToViewportPoint(root.Position)

    if rootScreen.Z <= 0 then
        data.Billboard.Enabled = false
        data.Highlight.Enabled = false

        for _, line in pairs(data.Lines) do
            setDrawingVisible(line, false)
        end

        setDrawingVisible(data.Tracer, false)
        setDrawingVisible(data.Head, false)
        return
    end

    data.Highlight.Adornee = character
    data.Highlight.Enabled = CONFIG.ESP.Box

    local head = character:FindFirstChild("Head")

    if head then
        data.Billboard.Adornee = head
        data.Billboard.Enabled =
            CONFIG.ESP.Name
            or CONFIG.ESP.Distance
            or CONFIG.ESP.Health

        local nameText = data.Billboard:FindFirstChild("Name")
        local infoText = data.Billboard:FindFirstChild("Info")
        local healthText = data.Billboard:FindFirstChild("Health")

        if nameText then
            nameText.Visible = CONFIG.ESP.Name
            nameText.Text = player.DisplayName
        end

        if infoText then
            infoText.Visible = CONFIG.ESP.Distance
            infoText.Text = string.format("%.0f studs", distance)
        end

        if healthText then
            healthText.Visible = CONFIG.ESP.Health
            healthText.Text = string.format(
                "HP %d/%d",
                math.floor(hum.Health),
                math.floor(hum.MaxHealth)
            )
        end

        if CONFIG.ESP.Head then
            local pos, vis = Camera:WorldToViewportPoint(head.Position)
            data.Head.Position = Vector2.new(pos.X, pos.Y)
            data.Head.Color = ESPColors.Head
            setDrawingVisible(data.Head, vis and pos.Z > 0)
        else
            setDrawingVisible(data.Head, false)
        end
    end

    -- R15 / R6 skeleton
    local joints = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"},
        {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
    }

    if not character:FindFirstChild("UpperTorso") then
        joints = {
            {"Head", "Torso"},
            {"Torso", "Left Arm"},
            {"Torso", "Right Arm"},
            {"Torso", "Left Leg"},
            {"Torso", "Right Leg"},
        }
    end

    local lineIndex = 0

    if CONFIG.ESP.Skeleton then
        for _, pair in ipairs(joints) do
            local a = character:FindFirstChild(pair[1])
            local b = character:FindFirstChild(pair[2])

            if a and b then
                lineIndex += 1

                local p1, v1 = Camera:WorldToViewportPoint(a.Position)
                local p2, v2 = Camera:WorldToViewportPoint(b.Position)

                local line = data.Lines[lineIndex]

                if line then
                    line.From = Vector2.new(p1.X, p1.Y)
                    line.To = Vector2.new(p2.X, p2.Y)
                    line.Color = ESPColors.Skeleton
                    line.Visible = v1 and v2 and p1.Z > 0 and p2.Z > 0
                end
            end
        end
    end

    for i = lineIndex + 1, #data.Lines do
        setDrawingVisible(data.Lines[i], false)
    end

    if CONFIG.ESP.Tracer then
        data.Tracer.From = Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y
        )

        data.Tracer.To = Vector2.new(rootScreen.X, rootScreen.Y)
        data.Tracer.Color = ESPColors.Tracer
        data.Tracer.Visible = rootVisible
    else
        setDrawingVisible(data.Tracer, false)
    end
end

