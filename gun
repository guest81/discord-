local function newDrawing(class, properties)
    local ok, obj = pcall(function()
        return Drawing.new(class)
    end)

    if not ok or not obj then
        return nil
    end

    for property, value in pairs(properties or {}) do
        pcall(function()
            obj[property] = value
        end)
    end

    return obj
end

