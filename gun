local function espFor(pl)
 if drawing[pl] then return drawing[pl] end

 local d={
  lines={},
  name=text(),
  dist=text(),
  hp=text(),
  box=square(),
  tracer=line(),
  head=square()
 }

 for i=1,16 do
  d.lines[i]=line()
 end

 drawing[pl]=d
 return d
end

local function hide(d)
 if not d then return end
 for _,x in ipairs(d.lines) do
  if x then x.Visible=false end
 end
 for _,x in ipairs({d.name,d.dist,d.hp,d.box,d.tracer,d.head}) do
  if x then x.Visible=false end
 end
end

local function clearESP(pl)
 local d=drawing[pl]
 if not d then return end
 hide(d)
 for _,x in ipairs(d.lines) do pcall(function() x:Remove() end) end
 for _,x in ipairs({d.name,d.dist,d.hp,d.box,d.tracer,d.head}) do
  pcall(function() x:Remove() end)
 end
 drawing[pl]=nil
end

local r6={
 {"Head","Torso"},
 {"Torso","Left Arm"},{"Torso","Right Arm"},
 {"Torso","Left Leg"},{"Torso","Right Leg"}
}

local r15={
 {"Head","UpperTorso"},
 {"UpperTorso","LowerTorso"},
 {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
 {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
 {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
 {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
}

local function espUpdate(pl,d)
 if not G.ESP or not valid(pl) then
  hide(d)
  return
 end

 local c=pl.Character
 local rootp=c:FindFirstChild("HumanoidRootPart")
 if not rootp then
  hide(d)
  return
 end

 local hp=c:FindFirstChildOfClass("Humanoid")
 local root2,onroot=CAM:WorldToViewportPoint(rootp.Position)
 if not onroot then
  hide(d)
  return
 end

 local headp=c:FindFirstChild("Head")
 local hs,onh=headp and CAM:WorldToViewportPoint(headp.Position) or root2

 local dist=(CAM.CFrame.Position-rootp.Position).Magnitude

 if G.Name then
  d.name.Visible=true
  d.name.Position=Vector2.new(root2.X,hs.Y-19)
  d.name.Text=pl.DisplayName or pl.Name
  d.name.Color=espColors.nm
 else d.name.Visible=false end

 if G.Dist then
  d.dist.Visible=true
  d.dist.Position=Vector2.new(root2.X,root2.Y+18)
  d.dist.Text=math.floor(dist).."m"
  d.dist.Color=espColors.ds
 else d.dist.Visible=false end

 if G.HP and hp then
  d.hp.Visible=true
  d.hp.Position=Vector2.new(root2.X,root2.Y+30)
  d.hp.Text=math.floor(hp.Health).."/"..math.floor(hp.MaxHealth)
  d.hp.Color=espColors.hp
 else d.hp.Visible=false end

 if G.Box then
  local h=math.abs(hs.Y-root2.Y)*2
  local w=h*.58
  d.box.Visible=true
  d.box.Position=Vector2.new(root2.X-w/2,root2.Y-h/2)
  d.box.Size=Vector2.new(w,h)
  d.box.Color=espColors.bx
 else d.box.Visible=false end

 if G.Head and headp and onh then
  d.head.Visible=true
  d.head.Position=Vector2.new(hs.X-3,hs.Y-3)
  d.head.Size=Vector2.new(6,6)
  d.head.Color=espColors.hd
 else d.head.Visible=false end

 if G.Tracer then
  d.tracer.Visible=true
  d.tracer.From=Vector2.new(CAM.ViewportSize.X/2,CAM.ViewportSize.Y)
  d.tracer.To=Vector2.new(root2.X,root2.Y)
  d.tracer.Color=espColors.tr
 else d.tracer.Visible=false end

 if G.Skel then
  local set=#r15
  local torso=c:FindFirstChild("UpperTorso") and r15 or r6

  for i,pair in ipairs(torso) do
   local a=c:FindFirstChild(pair[1])
   local b=c:FindFirstChild(pair[2])
   local l=d.lines[i]

   if a and b and l then
    local pa,oa=CAM:WorldToViewportPoint(a.Position)
    local pb,ob=CAM:WorldToViewportPoint(b.Position)

    if oa and ob then
     l.Visible=true
     l.From=Vector2.new(pa.X,pa.Y)
     l.To=Vector2.new(pb.X,pb.Y)
     l.Color=espColors.sk
    else
     l.Visible=false
    end
   elseif l then
    l.Visible=false
   end
  end

  for i=#torso+1,#d.lines do
   d.lines[i].Visible=false
  end
 else
  for _,l in ipairs(d.lines) do
   l.Visible=false
  end
 end
end

