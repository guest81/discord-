local function getRawScript(script)
    if not script then
        return nil
    end

    if script.script and #tostring(script.script) > 0 then
        return tostring(script.script)
    end

    local identifier = script.slug or script._id

    if not identifier then
        return nil
    end

    local url =
        "https://scriptblox.com/api/script/raw/"
        .. encode(identifier)

    return httpGet(url)
end

