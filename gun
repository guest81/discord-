--==============================================================
-- MAIN LOOP
--==============================================================

local lastFPSUpdate = os.clock()
local frames = 0

RunService.RenderStepped:Connect(function(dt)
    frames += 1

    -- FPS
    if os.clock() - lastFPSUpdate >= 1 then
        local fps = frames
        frames = 0
        lastFPSUpdate = os.clock()

        FPSLabel.Text = string.format(
            "FPS: %d  |  Ping: %d ms",
            fps,
            math.floor(getPing())
        )
    end

    -- Camera reference
    Camera = workspace.CurrentCamera or Camera

    -- FOV
    FOVCircle.Position = UDim2.fromOffset(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    FOVCircle.Size = UDim2.fromOffset(
        CONFIG.Aim.FOV * 2,
        CONFIG.Aim.FOV * 2
    )

    FOVCircle.Visible =
        CONFIG.Aim.Enabled
        or CONFIG.Aim.Assist

    -- AIM
    if CONFIG.Aim.Enabled or CONFIG.Aim.Assist then
        if not CONFIG.Aim.Sticky
            or not LockedTarget
            or not isAlive(LockedTarget) then

            LockedTarget = getClosestTarget()
        end

        if LockedTarget then
            local stillValid = aimAt(
                LockedTarget,
                dt,
                not CONFIG.Aim.Enabled
            )

            if not stillValid then
                LockedTarget = nil
            end
        end
    else
        LockedTarget = nil
    end

    -- FLY
    if CONFIG.Movement.Fly then
        if not FlyVelocity then
            startFly()
        end

        local character = LocalPlayer.Character
        local hum = getHumanoid(character)

        if FlyVelocity and hum then
            -- Humanoid.MoveDirection is the Roblox control vector.
            -- On mobile it follows the default joystick + camera.
            local move = hum.MoveDirection

            if move.Magnitude > 0.01 then
                FlyVelocity.VectorVelocity =
                    move.Unit * CONFIG.Movement.FlySpeed
            else
                FlyVelocity.VectorVelocity = Vector3.zero
            end

            hum.PlatformStand = false
        end
    else
        if FlyVelocity then
            stopFly()
        end
    end

    -- NOCLIP
    updateNoclip()

    -- WORLD
    if CONFIG.World.NoFog then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 99999
    end

    if CONFIG.World.Fullbright then
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    end

    -- ESP
    for player, data in pairs(ESPObjects) do
        if player.Parent == Players then
            updateESP(player, data)
        else
            destroyESP(player)
        end
    end
end)

