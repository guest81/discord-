                        or decoded.result
                        or decoded.raw
                        or decoded.data

                    if type(content) == "string" then
                        ScriptPreview.Text = content:sub(1, 1800)
                        ScriptState.Current.RawScript = content
                        return
                    end
                end

                ScriptState.Current.RawScript = raw
                ScriptPreview.Text = raw:sub(1, 1800)
            else
                ScriptPreview.Text = "Unable to fetch raw script."
            end
        end)
    end)

    return card
end

local function buildResults(results, query)
    clearResults()

    table.sort(results, function(a, b)
        return scoreScript(a, query) > scoreScript(b, query)
    end)

    local shown = 0

    for _, script in ipairs(results) do
        if ScriptState.Verified and not script.verified then
            continue
        end

        if ScriptState.NoKey and script.key then
            continue
        end

        if ScriptState.Working and script.isPatched then
            continue
        end

        shown += 1

        if shown > 20 then
            break
        end

        makeResultCard(script, shown)
    end

    if shown == 0 then
        local empty = label(
            ResultsHolder,
            "No matching scripts found.",
            UDim2.new(1, 0, 0, 35),
            nil,
            10
        )

        empty.TextColor3 = CONFIG.UI.Muted
        empty.TextXAlignment = Enum.TextXAlignment.Center
    end
end

local function searchScripts()
    local query = SearchBox.Text

    if query == "" and ScriptState.FilterGame then
        query = game.Name
    end

    SearchButton.Text = "..."
    Status.Text = "● SEARCHING"

    local url =
        "https://scriptblox.com/api/script/search"
        .. "?q=" .. encode(query)
        .. "&max=20"
        .. "&sortBy=" .. encode(ScriptState.Sort)
        .. "&order=desc"
        .. "&strict=false"

    if ScriptState.FilterGame then
        url = url .. "&placeId=" .. tostring(game.PlaceId)
    end

    local raw = httpGet(url)

    if not raw then
        SearchButton.Text = "SEARCH"
        Status.Text = "● HTTP ERROR"

        clearResults()

        local err = label(
            ResultsHolder,
            "Search request failed.",
            UDim2.new(1, 0, 0, 35),
            nil,
            10
        )

        err.TextColor3 = Color3.fromRGB(235, 135, 135)
        err.TextXAlignment = Enum.TextXAlignment.Center
        return
    end

    local data = jsonDecode(raw)

    if not data then
        SearchButton.Text = "SEARCH"
        Status.Text = "● JSON ERROR"
        return
    end

    local results =
        data.result
        and data.result.scripts
        or data.scripts
        or {}

    ScriptState.Results = results

    buildResults(results, query)

    SearchButton.Text = "SEARCH"
    Status.Text = "● READY"
end

SearchButton.MouseButton1Click:Connect(searchScripts)

SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        searchScripts()
    end
end)

