local lastFrame = os.clock()
local fps = 60

RunService.RenderStepped:Connect(function(dt)
    Camera = Workspace.CurrentCamera or Camera

    --------------------------------------------------
    -- FPS
    --------------------------------------------------

    local now = os.clock()
    local delta = math.max(now - lastFrame, 0.001)
    lastFrame = now

    fps = math.floor(
        math.clamp(
            1 / delta,
            1,
            999
        )
    )

    StatsLabel.Text =
        "FPS: "
        .. tostring(fps)
        .. "   •   Ping: "
        .. tostring(math.floor(getPing()))
        .. "ms"

    --------------------------------------------------
    -- FOV
    --------------------------------------------------

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    if FOVCircle then
        FOVCircle.Position = center
        FOVCircle.Radius = Config.Aim.FOV
        FOVCircle.Visible = Config.Aim.Enabled

        FOVCircle.Color = CurrentTarget
            and Colors.Target
            or Colors.Accent
    end

    if FOVFrame then
        FOVFrame.Position = UDim2.fromOffset(
            center.X,
            center.Y
        )

        FOVFrame.Size = UDim2.fromOffset(
            Config.Aim.FOV * 2,
            Config.Aim.FOV * 2
        )

        FOVFrame.Visible = Config.Aim.Enabled
    end

    --------------------------------------------------
    -- SMART AIM
    --------------------------------------------------

    if Config.Aim.Enabled then
        if Config.Aim.Lock then
            if not validCurrentTarget() then
                CurrentTarget = acquireTarget()
            end
        else
            CurrentTarget = acquireTarget()
        end

        if CurrentTarget and alive(CurrentTarget) then
            local part = getTargetPart(CurrentTarget.Character)

            if part then
                local root = getRoot(CurrentTarget)

                if root then
                    local pingSeconds =
                        math.clamp(
                            getPing() / 1000,
                            0.01,
                            0.25
                        )

                    local velocity =
                        root.AssemblyLinearVelocity

                    local prediction =
                        velocity
                        * pingSeconds
                        * Config.Aim.Prediction

                    local predictedPosition =
                        part.Position + prediction

                    local desired =
                        CFrame.lookAt(
                            Camera.CFrame.Position,
                            predictedPosition
                        )

                    local adaptive =
                        1 - math.exp(
                            -dt / math.max(
                                Config.Aim.Smooth,
                                0.015
                            )
                        )

                    adaptive = math.clamp(
                        adaptive,
                        0.03,
                        1
                    )

                    Camera.CFrame =
                        Camera.CFrame:Lerp(
                            desired,
                            adaptive
                        )
                end
            end
        end
    else
        CurrentTarget = nil
    end

    --------------------------------------------------
    -- ESP
    --------------------------------------------------

    for player, data in pairs(ESPData) do
        if player.Parent then
            safeCall(updateESP, player, data)
        end
    end

    --------------------------------------------------
    -- MOVEMENT
    --------------------------------------------------

    local character = LocalPlayer.Character
    local hum = getHumanoid(LocalPlayer)
    local root = getRoot(LocalPlayer)

    if hum then
        if not Config.Move.Fly then
            hum.WalkSpeed = Config.Move.WalkSpeed
            hum.JumpPower = Config.Move.JumpPower
        end
    end

    if Config.Move.Fly then
        FlyControls.Visible = true

        if not FlyVelocity
            or not FlyVelocity.Parent then
            setupFly()
        end

        if FlyVelocity and root then
            local moveVector = Vector3.zero

            if PlayerControls then
                local ok, result = pcall(function()
                    return PlayerControls:GetMoveVector()
                end)

                if ok and result then
                    moveVector = result
                end
            end

            local cameraCF = Camera.CFrame

            local horizontal =
                cameraCF.RightVector * moveVector.X
                + cameraCF.LookVector * (-moveVector.Z)

            local vertical =
                Vector3.new(
                    0,
                    FlyVertical,
                    0
                )

            local direction =
                horizontal + vertical

            if direction.Magnitude > 1 then
                direction = direction.Unit
            end

            FlyVelocity.VectorVelocity =
                direction * Config.Move.FlySpeed
        end
    else
        FlyControls.Visible = false

        if FlyVelocity then
            stopFly()
        end
    end

    --------------------------------------------------
    -- NOCLIP
    --------------------------------------------------

    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if Config.Move.Noclip then
                    part.CanCollide = false
                end
            end
        end
    end

    --------------------------------------------------
    -- WORLD
    --------------------------------------------------

    Workspace.Gravity = Config.World.Gravity

    Lighting.ClockTime = Config.World.ClockTime

    if Config.World.Fullbright then
        Lighting.Brightness = 3
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    else
        Lighting.Brightness = oldLighting.Brightness
        Lighting.Ambient = oldLighting.Ambient
        Lighting.OutdoorAmbient = oldLighting.OutdoorAmbient
    end

    if Config.World.NoFog then
        Lighting.FogStart = 100000
        Lighting.FogEnd = 100000
    else
        Lighting.FogStart = oldLighting.FogStart
        Lighting.FogEnd = oldLighting.FogEnd
    end
end)

