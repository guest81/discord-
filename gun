local function scoreScript(script, query)
    local score = 0

    local title = string.lower(tostring(script.title or ""))
    local gameName = string.lower(tostring(
        script.game and script.game.name or ""
    ))

    local q = string.lower(query or "")

    if q ~= "" then
        for token in q:gmatch("%S+") do
            if title:find(token, 1, true) then
                score += 30
            end

            if gameName:find(token, 1, true) then
                score += 25
            end
        end
    end

    if ScriptState.FilterGame then
        local placeId = tonumber(
            script.game
            and (
                script.game.gameId
                or script.game.placeId
                or script.game.universeId
            )
        )

        if placeId == game.PlaceId then
            score += 120
        elseif script.isUniversal then
            score += 35
        end
    end

    if script.verified then
        score += 20
    end

    if not script.key then
        score += 12
    end

    if not script.isPatched then
        score += 15
    end

    score += math.min(
        tonumber(script.views) or 0,
        100000
    ) / 10000

    return score
end

