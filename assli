local shakeEnabled = false
local shakeActive = false
local shakeTime, shakeIndex = 0, 1
local shakeConn = nil
local lastCamYaw = nil
local recentChanges = {}
local lastDir = 0
local lastChangeTime = 0
local shakeThreshold = .04
local shakeWindow = .4
local shakeSpeedValues = {.5, 1, 1.5, 2, 3, 5}
local shakeSpeedIndex = 2

local function hasTool()
    local c = lp.Character
    local bp = lp:FindFirstChildOfClass("Backpack")
    return (c and c:FindFirstChildOfClass("Tool") ~= nil) or (bp and bp:FindFirstChildOfClass("Tool") ~= nil)
end
local function refreshShakeUI()
    shakeBtn.Text = shakeEnabled and "Shake · ON" or "Shake · OFF"
    shakeSpeedBtn.Text = tostring(shakeSpeedValues[shakeSpeedIndex]) .. "x"
    styleButton(shakeBtn, shakeEnabled)
    if not shakeEnabled then shakeStatus.Text = "disabled" shakeStatus.TextColor3 = DIM end
end
local function stopShake()
    if not shakeActive then return end
    shakeActive = false
    if shakeConn then shakeConn:Disconnect() shakeConn = nil end
    if shakeEnabled then shakeStatus.Text = "waiting..." shakeStatus.TextColor3 = DIM end
    shakeTime, shakeIndex = 0, 1
end
local function startShake()
    if shakeActive then return end
    shakeActive = true
    shakeStatus.Text = "active"
    shakeStatus.TextColor3 = ACC
    shakeConn = R.RenderStepped:Connect(function(delta)
        if not hasTool() then stopShake() return end
        local c = lp.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp or U.MouseBehavior ~= Enum.MouseBehavior.LockCenter then return end
        local intensity = shakeSpeedValues[shakeSpeedIndex]
        shakeTime = shakeTime + delta * 2 * intensity
        shakeIndex = math.floor(shakeTime * 60) + 1
        if shakeIndex > #shakeOffsets then shakeIndex = 1 shakeTime = 0 end
        local pos = hrp.CFrame.Position
        workspace.CurrentCamera.CFrame = CFrame.new(pos) * CFrame.Angles(0, shakeOffsets[shakeIndex] * 3, 0) * CFrame.new(-pos) * workspace.CurrentCamera.CFrame
    end)
end

R.RenderStepped:Connect(function()
    if not shakeEnabled then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local _, yaw = cam.CFrame:ToEulerAnglesYXZ()
    if not hasTool() then
        if shakeActive then stopShake() end
        recentChanges = {} lastDir = 0
        barFill.Size = UDim2.new(0, 0, 1, 0)
        shakeStatus.Text = "waiting tool..." shakeStatus.TextColor3 = DIM
        lastCamYaw = yaw
        return
    end
    if lastCamYaw == nil then lastCamYaw = yaw return end
    local diff = yaw - lastCamYaw
    if diff > math.pi then diff = diff - 2 * math.pi end
    if diff < -math.pi then diff = diff + 2 * math.pi end
    if math.abs(diff) > shakeThreshold then
        lastChangeTime = tick()
        if lastDir ~= 0 and diff * lastDir < 0 then table.insert(recentChanges, tick()) end
        lastDir = diff
        local now = tick()
        local filtered = {}
        local count = 0
        for _, t in ipairs(recentChanges) do
            if now - t <= shakeWindow then count = count + 1 table.insert(filtered, t) end
        end
        recentChanges = filtered
        barFill.Size = UDim2.new(math.min(count / 3, 1), 0, 1, 0)
        if count >= 3 and not shakeActive then startShake() end
    elseif shakeActive and tick() - lastChangeTime >= .5 then
        stopShake() recentChanges = {} barFill.Size = UDim2.new(0, 0, 1, 0)
    end
    lastCamYaw = yaw
end)

