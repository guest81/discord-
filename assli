-- ============ Wall Slide ============
local wallSlideEnabled = false
local wsCharacter, wsHumanoid, wsHRP, wsAttachment, wsVelocity
local wsCharConn, wsLoopConn
local raycastParams = RaycastParams.new()
pcall(function() raycastParams.FilterType = Enum.RaycastFilterType.Exclude end)
raycastParams.IgnoreWater = true

local function flatUnit(v)
    local f = Vector3.new(v.X, 0, v.Z)
    return f.Magnitude > .001 and f.Unit or Vector3.new(0, 0, 0)
end
local function safeUnit(v, fallback)
    return v.Magnitude > .001 and v.Unit or fallback
end
local function destroySlideVelocity()
    if wsVelocity then pcall(function() wsVelocity:Destroy() end) wsVelocity = nil end
end
local function restoreWallSlide()
    destroySlideVelocity()
    if wsHumanoid and wsHumanoid.Parent then wsHumanoid.AutoRotate = true end
end
local function createSlideVelocity()
    if not wsHRP or not wsAttachment then return nil end
    local ok, vel = pcall(function()
        local lv = Instance.new("LinearVelocity")
        lv.Name = "SuiteSlideVel"
        lv.Attachment0 = wsAttachment
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        lv.MaxForce = 100000
        pcall(function()
            lv.ForceLimitsEnabled = true
            lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
            lv.MaxAxesForce = Vector3.new(100000, 0, 100000)
        end)
        lv.Parent = wsHRP
        return lv
    end)
    if ok and vel then return vel end
    local ok2, bv = pcall(function()
        local b = Instance.new("BodyVelocity")
        b.Name = "SuiteSlideVel"
        b.MaxForce = Vector3.new(100000, 0, 100000)
        b.P = 1250
        b.Parent = wsHRP
        return b
    end)
    return ok2 and bv or nil
end
local function getWallNormal(moveDir)
    if not wsHRP then return nil end
    local normals = {}
    local side = Vector3.new(-moveDir.Z, 0, moveDir.X)
    local pos = wsHRP.Position
    local origins = {pos, pos + side * .25, pos - side * .25}
    local dirs = {moveDir, safeUnit(moveDir + side * .25, moveDir), safeUnit(moveDir - side * .25, moveDir)}
    for i = 1, 3 do
        local result = workspace:Raycast(origins[i], dirs[i] * 1.35, raycastParams)
        if result and result.Instance and result.Instance:IsA("BasePart") and result.Instance.CanCollide and math.abs(result.Normal.Y) <= .3 then
            local n = flatUnit(result.Normal)
            if n.Magnitude > .001 and moveDir:Dot(n) < -.01 then
                table.insert(normals, n)
            end
        end
    end
    if #normals == 0 then return nil end
    local sum = Vector3.new(0, 0, 0)
    for _, n in ipairs(normals) do sum = sum + n end
    return safeUnit(sum, normals[1])
end
local function onWallSlideCharacter(char)
    restoreWallSlide()
    if wsAttachment then pcall(function() wsAttachment:Destroy() end) wsAttachment = nil end
    wsCharacter = char
    wsHumanoid = char:WaitForChild("Humanoid", 5)
    wsHRP = char:WaitForChild("HumanoidRootPart", 5)
    if not wsHumanoid or not wsHRP then return end
    for _, n in ipairs({"SuiteSlideVel", "SuiteSlideAtt"}) do
        local old = wsHRP:FindFirstChild(n)
        if old then pcall(function() old:Destroy() end) end
    end
    wsAttachment = Instance.new("Attachment")
    wsAttachment.Name = "SuiteSlideAtt"
    wsAttachment.Parent = wsHRP
end
local function wallSlideStep()
    if not wallSlideEnabled then return end
    if not wsCharacter or not wsCharacter.Parent or not wsHumanoid or wsHumanoid.Health <= 0 or not wsHRP or not wsHRP.Parent then
        restoreWallSlide() return
    end
    local chars = {}
    for _, p in ipairs(P:GetPlayers()) do
        if p.Character then table.insert(chars, p.Character) end
    end
    raycastParams.FilterDescendantsInstances = chars
    local moveDir = flatUnit(wsHumanoid.MoveDirection)
    if moveDir.Magnitude < .08 then restoreWallSlide() return end
    local normal = getWallNormal(moveDir)
    if not normal then restoreWallSlide() return end
    local vel = wsHRP.Velocity
    local yTarget = wsHumanoid.FloorMaterial ~= Enum.Material.Air and 0 or math.min(vel.Y, 1.5)
    if math.abs(yTarget - vel.Y) > .01 then
        wsHRP.Velocity = Vector3.new(vel.X, yTarget, vel.Z)
    end
    if not wsVelocity or not wsVelocity.Parent then wsVelocity = createSlideVelocity() end
    if not wsVelocity then return end
    local slideDir = flatUnit(moveDir - normal * moveDir:Dot(normal))
    local finalDir = slideDir.Magnitude > .05 and slideDir or safeUnit(Vector3.new(-normal.Z, 0, normal.X), Vector3.new(1, 0, 0))
    local target = finalDir * wsHumanoid.WalkSpeed + normal * .01
    local vectorVel = Vector3.new(target.X, 0, target.Z)
    if wsVelocity:IsA("LinearVelocity") then
        wsVelocity.VectorVelocity = vectorVel
    elseif wsVelocity:IsA("BodyVelocity") then
        wsVelocity.Velocity = vectorVel
    end
    wsHumanoid.AutoRotate = true
end
local function stopWallSlide()
    wallSlideEnabled = false
    if wsCharConn then pcall(function() wsCharConn:Disconnect() end) wsCharConn = nil end
    if wsLoopConn then pcall(function() wsLoopConn:Disconnect() end) wsLoopConn = nil end
    restoreWallSlide()
    if wsAttachment then pcall(function() wsAttachment:Destroy() end) wsAttachment = nil end
    wsCharacter, wsHumanoid, wsHRP = nil, nil, nil
end
local function startWallSlide()
    wallSlideEnabled = true
    if lp.Character then onWallSlideCharacter(lp.Character) end
    wsCharConn = lp.CharacterAdded:Connect(function(char)
        pcall(function()
            task.wait(.15)
            if wallSlideEnabled then onWallSlideCharacter(char) end
        end)
    end)
    wsLoopConn = R.Heartbeat:Connect(function()
        local ok, err = pcall(wallSlideStep)
        if not ok then
            stopWallSlide()
            warn("[Wall Slide] stopped safely: " .. tostring(err))
        end
    end)
end

