local KFX_hooked = setmetatable({}, {__mode = "k"})
local KFX_played = setmetatable({}, {__mode = "k"})
local function KFX_snapshot(char, cf)
    local clone
    pcall(function()
        local old = char.Archivable
        char.Archivable = true
        clone = char:Clone()
        char.Archivable = old
    end)
    if not clone then return nil end
    for _, d in ipairs(clone:GetDescendants()) do
        pcall(function()
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Humanoid")
                or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("ForceField")
                or d:IsA("Tool") or d:IsA("Highlight") or d:IsA("ParticleEmitter")
                or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                d:Destroy()
            end
        end)
    end
    for _, p in ipairs(H.parts(clone)) do
        p.Anchored = true p.CanCollide = false p.CanTouch = false p.CanQuery = false p.Massless = true
    end
    if cf then clone:PivotTo(cf) end
    clone.Parent = KFX_Folder
    D:AddItem(clone, 12)
    return clone
end
local function KFX_hideOriginal(char)
    local function hide()
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then d.LocalTransparencyModifier = 1 d.Transparency = 1
            elseif d:IsA("Decal") or d:IsA("Texture") then d.Transparency = 1
            elseif d:IsA("BillboardGui") then d.Enabled = false end
        end
    end
    hide()
    task.spawn(function()
        local t = os.clock()
        while os.clock() - t < 8 and char.Parent do
            hide() R.Heartbeat:Wait()
        end
    end)
end
local function KFX_play(id, char, cf)
    local fn = KFX_FX[id]
    if not fn or not char then return end
    local m = KFX_snapshot(char, cf)
    if not m then return end
    if not cf then KFX_hideOriginal(char) end
    local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
    if not hrp then m:Destroy() return end
    local ok = pcall(fn, m, hrp)
    if not ok then m:Destroy() end
end
local function KFX_onDeath(char)
    if KFX_played[char] then return end
    KFX_played[char] = true
    if KFX.current <= 1 then return end
    local mR = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local rt = char:FindFirstChild("HumanoidRootPart")
    if not (mR and rt) then return end
    if (rt.Position - mR.Position).Magnitude > KFX.range then return end
    KFX_play(KFX.list[KFX.current].id, char)
end
local function KFX_watchChar(char)
    if KFX_hooked[char] then return end
    KFX_hooked[char] = true
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local fired = false
    local function died()
        if fired then return end
        fired = true
        pcall(KFX_onDeath, char)
    end
    hum.Died:Connect(died)
    hum.HealthChanged:Connect(function(h) if h <= 0 then died() end end)
end
local function KFX_watchPlayer(p)
    if p == lp then return end
    if p.Character then task.spawn(KFX_watchChar, p.Character) end
    p.CharacterAdded:Connect(KFX_watchChar)
end
for _, p in ipairs(P:GetPlayers()) do KFX_watchPlayer(p) end
P.PlayerAdded:Connect(KFX_watchPlayer)

