                    * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
            })
            local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(.2, 1.2), rng:NextNumber(-1, 1)).Unit
