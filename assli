        local m = Instance.new("SpecialMesh")
        m.Name = "HeadlessMesh"
        m.MeshType = Enum.MeshType.FileMesh
        m.MeshId = HEADLESS_MESH_ID
        m.Scale = Vector3.new(.001, .001, .001)
