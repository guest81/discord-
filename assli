local ahTargetDistance = 9
local ahRushAtTime = 2.0
local ahOrbitSpeed = 4
local ahSmoothTurn = .25
local ahOrbitAngle = 0
local ahOrbitDirection = 1
local ahLastEnemyPos = Vector3.new(0, 0, 0)
local ahDistValues = {6, 8, 9, 11, 13, 15}
local ahRushValues = {1.0, 1.5, 2.0, 2.5, 3.0, 4.0}
local ahOrbitValues = {2, 3, 4, 5, 6, 8}
local ahSmoothValues = {.15, .2, .25, .35, .5}
local ahDistIndex, ahRushIndex, ahOrbitIndex, ahSmoothIndex = 3, 3, 3, 3

local function ahGetBombTime(tool)
    if not tool then return nil end
    for _, obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextBox") then
            local n = tonumber(string.match(obj.Text or "", "%d+%.?%d*"))
            if n then return n end
        end
    end
    for _, obj in ipairs(tool:GetDescendants()) do
        if (obj:IsA("NumberValue") or obj:IsA("IntValue")) and string.lower(obj.Name):find("time") then
            return obj.Value
        end
    end
    return nil
end
local function ahGetClosestEnemy()
    local enemies, arena = detectEnemies()
    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, math.huge end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(enemies) do
        if p.Character and isPlayerAlive(p) and isPlayerOnFloor(p, arena) then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (myHRP.Position - hrp.Position).Magnitude
                if d < bestDist then bestDist = d best = p end
            end
        end
    end
    return best, bestDist
end
R.Heartbeat:Connect(function(dt)
    if not autoHoldActive then return end
    local c = lp.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end
    local tool = c:FindFirstChildOfClass("Tool")
    if not tool then autoHoldStatus.Text = "status · no bomb" return end
    local rt = ahGetBombTime(tool) or 99
    if rt <= ahRushAtTime then
        autoHoldStatus.Text = string.format("status · RUSH %.1fs", rt)
        local t = ahGetClosestEnemy()
        if t and t.Character then
            local th = t.Character:FindFirstChild("HumanoidRootPart")
            if th then
                local targetCF = CFrame.new(hrp.Position, Vector3.new(th.Position.X, hrp.Position.Y, th.Position.Z)) * CFrame.Angles(0, math.rad(35), 0)
                hrp.CFrame = hrp.CFrame:Lerp(targetCF, ahSmoothTurn)
                hum:MoveTo(th.Position)
                pcall(function() tool:Activate() end)
            end
        end
        return
    end
    local t = ahGetClosestEnemy()
    if not t or not t.Character then autoHoldStatus.Text = "status · no target" return end
    autoHoldStatus.Text = string.format("status · orbit %s · %.1fs", t.Name, rt)
    local th = t.Character:FindFirstChild("HumanoidRootPart")
    if not th then return end
    local ev = th.Position - ahLastEnemyPos
    local mr = hrp.CFrame.RightVector
    local dot = ev:Dot(mr)
    if dot > .05 then ahOrbitDirection = -1
    elseif dot < -.05 then ahOrbitDirection = 1 end
    ahLastEnemyPos = th.Position
    ahOrbitAngle = ahOrbitAngle + (dt * ahOrbitSpeed * ahOrbitDirection)
    local of = Vector3.new(math.sin(ahOrbitAngle), 0, math.cos(ahOrbitAngle)) * ahTargetDistance
    local gp = th.Position + of
    local ld = (hrp.Position - th.Position).Unit
    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(ld.X, 0, ld.Z))
    hum:MoveTo(gp)
end)

